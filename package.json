{
  "name": "intellect-site",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "astro dev",
    "clean": "node -e \"for (const d of ['dist','.astro','node_modules/.astro','node_modules/.vite']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "astro check",
    "lint": "eslint .",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-site.mjs",
    "build:globe": "node scripts/build-globe-data.mjs",
    "media": "node scripts/fetch-media.mjs",
    "images": "node scripts/prep-images.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.0.0",
    "@imgly/background-removal-node": "^1.4.5",
    "d3-geo": "^3.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "sharp": "^0.33.5",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "world-atlas": "^2.0.2"
  }
}
