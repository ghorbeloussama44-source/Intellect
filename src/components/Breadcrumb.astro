---
import type { Crumb } from '../seo/schema';
import { useUi } from '../locales';
import type { Locale } from '../config/site';

interface Props { locale: Locale; trail: Crumb[] }
const { locale, trail } = Astro.props;
const ui = useUi(locale);
---
{trail.length > 1 && (
  <nav class="crumbs" aria-label={ui.breadcrumbLabel}>
    <ol>
      {trail.map((c, i) => (
        <li>{i === trail.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
      ))}
    </ol>
  </nav>
)}
