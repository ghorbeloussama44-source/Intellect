---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { LOCALES, LOCALE_META, SITE_NAME, type Locale } from '../config/site';
import { pagePath, getPage, publishedPages, type PageDef } from '../config/pages';
import { getContent } from '../copy';
import { useUi } from '../locales';

interface Props { locale: Locale; page?: PageDef }
const { locale, page } = Astro.props;
const ui = useUi(locale);
const home = getPage('home') as PageDef;
const target = page ?? home;
const groups = (['learn', 'study', 'about'] as const).map((g) => ({
  title: ui.footer[g],
  links: publishedPages().filter((p) => p.footerGroup === g && getContent(p.id, locale)).map((p) => ({ href: pagePath(p, locale), label: getContent(p.id, locale)?.nav ?? '' })),
}));
---
<footer class="site-footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href={pagePath(home, locale)}><Image src={logo} alt={ui.logoAlt} width={141} height={48} loading="lazy" /></a>
        <p>{ui.footer.slogan}</p>
      </div>
      {groups.map((g) => g.links.length > 0 && (
        <nav aria-label={g.title}>
          <h3>{g.title}</h3>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} {SITE_NAME} — {ui.footer.rights}</span>
      <nav class="langs" aria-label={ui.footer.languages}>
        {LOCALES.map((l) => <a href={pagePath(target, l)} hreflang={LOCALE_META[l].htmlLang} lang={LOCALE_META[l].htmlLang}>{LOCALE_META[l].label}</a>)}
      </nav>
    </div>
    <p class="foot-bottom" style="border:0;margin-block-start:8px;padding:0;opacity:.75">{ui.footer.note}</p>
  </div>
</footer>
